# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: set to "true" to allow MockPaymentProvider upgrade without auth admin
NEXT_PUBLIC_BILLING_MOCK=true

# AI Intelligence nightly cron (required for /api/cron/ai-intel)
# Generate: openssl rand -hex 32
CRON_SECRET=

# Optional: LLM features — AI Intel summaries and the dev expenses advisor
# (provider detection, per-service diagnostic, whole-budget review).
# Free (recommended): Google AI Studio — no credit card
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional alias: GEMINI_API_KEY=

# Optional: Vercel AI Gateway instead (uses $5 free credit, then paid)
# https://vercel.com/docs/ai-gateway
# AI_GATEWAY_API_KEY=

# Optional tuning for the nightly analysis
# AI_INTEL_LLM_MODEL=gemini-3.6-flash        # default: gemini-3.6-flash
# AI_INTEL_LLM_BUDGET=80                     # max Gemini calls per run
# AI_INTEL_LLM_MIN_INTERVAL_MS=4000          # spacing between calls (free tier is per-minute)
# AI_INTEL_ARTICLE_SCRAPES=60                # max articles fully scraped per run
# AI_INTEL_REPO_SCRAPES=40                   # max GitHub repos fully scraped per run
# AI_INTEL_TOOL_SCRAPES=30                   # max tool pages fully scraped per run
# AI_INTEL_LLM_DEBUG=1                       # log why a Gemini call fell back to heuristics

# Optional tuning for the dev expenses advisor
# Without a key the module still works: it falls back to its offline catalog.
# EXPENSES_LLM_MODEL=gemini-3.6-flash        # default: same model as AI Intel
# EXPENSES_LLM_DEBUG=1                       # log why an advisor call fell back to the catalog

# Optional tuning for the daily dev tools catalogue scrape
# Without a key the catalogue still fills: GitHub metrics and pricing keywords only.
# DEV_TOOLS_LLM_MODEL=gemini-3.6-flash       # default: same model as AI Intel
# DEV_TOOLS_LLM_BUDGET=70                    # max classification calls per run
# DEV_TOOLS_LLM_MIN_INTERVAL_MS=4000         # spacing between calls (free tier is per-minute)
# DEV_TOOLS_REFRESH_DAYS=7                   # how often a row gets re-classified
# DEV_TOOLS_MIN_STARS=2000                   # discovery threshold on GitHub search
# DEV_TOOLS_PER_TOPIC=6                      # repos kept per GitHub topic
# DEV_TOOLS_LLM_DEBUG=1                      # log why a classification was dropped

# HTML scraping (job offers, AI intel articles, pricing pages, HTML lists)
# https://www.firecrawl.dev/app/api-keys
# Without it, scrapers fall back to a direct GET (weaker on JS-heavy pages).
FIRECRAWL_API_KEY=

# Optional: discover new AI news sites each night (Tavily)
# https://tavily.com — without it, scrape still runs on seeded sources
TAVILY_API_KEY=

# Optional: higher GitHub rate limits for the AI intel and dev tools scrapes
# GITHUB_TOKEN=

# Web Push for installed PWA (required for phone alerts after scrape)
# Generate: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
