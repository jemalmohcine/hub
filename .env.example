# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: set to "true" to allow MockPaymentProvider upgrade without auth admin
NEXT_PUBLIC_BILLING_MOCK=true

# AI Intelligence nightly cron (required for /api/cron/ai-intel)
# Generate: openssl rand -hex 32
CRON_SECRET=

# Optional: LLM summaries for AI Intel (title + 3 essential points after scrape)
# Free (recommended): Google AI Studio — no credit card
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional alias: GEMINI_API_KEY=

# Optional: Vercel AI Gateway instead (uses $5 free credit, then paid)
# https://vercel.com/docs/ai-gateway
# AI_GATEWAY_API_KEY=

# Optional tuning for the nightly analysis
# AI_INTEL_LLM_MODEL=gemini-3.6-flash        # default: gemini-3.6-flash
# AI_INTEL_LLM_BUDGET=80                     # max Gemini calls per run
# AI_INTEL_LLM_MIN_INTERVAL_MS=4000          # spacing between calls (free tier is per-minute)
# AI_INTEL_ARTICLE_SCRAPES=60                # max articles fully scraped per run
# AI_INTEL_REPO_SCRAPES=40                   # max GitHub repos fully scraped per run
# AI_INTEL_TOOL_SCRAPES=30                   # max tool pages fully scraped per run
# AI_INTEL_LLM_DEBUG=1                       # log why a Gemini call fell back to heuristics

# Optional: discover new AI news sites each night (Tavily)
# https://tavily.com — without it, scrape still runs on seeded sources
TAVILY_API_KEY=

# Optional: higher GitHub rate limits if you add a GitHub HTML/API collector later
# GITHUB_TOKEN=

# Web Push for installed PWA (required for phone alerts after scrape)
# Generate: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
