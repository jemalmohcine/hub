# Supabase (Project Settings → API) — projet lfxiyrcfiieyxeziuglv
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app URL (OAuth redirects, emails)
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Veille IA — ingest matinal (agent Info Ai)
# POST /api/veille/ingest — header x-ingest-secret
# Generate: openssl rand -hex 32
VEILLE_INGEST_SECRET=

# Catalogue dev_tools (GitHub Actions dev-tools-ingest.yml)
GOOGLE_GENERATIVE_AI_API_KEY=
GITHUB_TOKEN=

# Optional: dev-tools LLM / scrape tuning
# DEV_TOOLS_LLM_MODEL=
# DEV_TOOLS_REFRESH_DAYS=7
# FIRECRAWL_API_KEY=

# Legacy job-board maintenance script only (scraping offres reporté)
# VAPID_* if push notifications reintroduced
